{
  "name": "lembar",
  "version": "0.1.0",
  "private": true,
  "description": "Aplikasi catatan Markdown pribadi yang berjalan lokal",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "test": "node --test",
    "icons": "node scripts/icons.js",
    "service:install": "node scripts/service.js install",
    "service:uninstall": "node scripts/service.js uninstall",
    "service:status": "node scripts/service.js status"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "11.12.0",
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "markdown-it": "^15.0.2",
    "puppeteer-core": "^25.12.0"
  }
}
